                "url": "./#/metrics?metrics=[[[\"last_over_time((max by (k8s_cluster_name,pvc_namespace,pvc,volume,state) (longhorn_volume_robustness{k8s_cluster_name=~\\\"${storage_cluster}\\\",volume=~\\\"${storage_volume}\\\",state=~\\\"degraded|faulted\\\"}) == 1)[1s:1s] @ end())\"]],[0,[6,[true,\"\"]]]]"
              }
