{
  "dashboard": {
    "metadata": {
      "project": "{\"saveVariables\":false}"
    },
    "spec": {
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "items": [
              {
                "content": {
                  "$ref": "#/spec/panels/guide"
                },
                "height": 1,
                "width": 24,
                "x": 0,
                "y": 0
              },
              {
                "content": {
                  "$ref": "#/spec/panels/unhealthy"
                },
                "height": 2,
                "width": 8,
                "x": 0,
                "y": 1
              },
              {
                "content": {
                  "$ref": "#/spec/panels/neverBackup"
                },
                "height": 2,
                "width": 8,
                "x": 8,
                "y": 1
              },
              {
                "content": {
                  "$ref": "#/spec/panels/staleBackup"
                },
                "height": 2,
                "width": 8,
                "x": 16,
                "y": 1
              },
              {
                "content": {
                  "$ref": "#/spec/panels/unhealthyDetails"
                },
                "height": 3,
                "width": 24,
                "x": 0,
                "y": 3
              },
              {
                "content": {
                  "$ref": "#/spec/panels/staleBackupDetails"
                },
                "height": 3,
                "width": 24,
                "x": 0,
                "y": 6
              },
              {
                "content": {
                  "$ref": "#/spec/panels/neverBackupDetails"
                },
                "height": 3,
                "width": 24,
                "x": 0,
                "y": 9
              },
              {
                "content": {
                  "$ref": "#/spec/panels/volumeHealth"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 12
              },
              {
                "content": {
                  "$ref": "#/spec/panels/attachment"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 12
              },
              {
                "content": {
                  "$ref": "#/spec/panels/physicalStorage"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 15
              },
              {
                "content": {
                  "$ref": "#/spec/panels/scheduledStorage"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 15
              },
              {
                "content": {
                  "$ref": "#/spec/panels/logicalCapacity"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 18
              },
              {
                "content": {
                  "$ref": "#/spec/panels/snapshotSpace"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 18
              },
              {
                "content": {
                  "$ref": "#/spec/panels/iops"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 21
              },
              {
                "content": {
                  "$ref": "#/spec/panels/latency"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 21
              },
              {
                "content": {
                  "$ref": "#/spec/panels/backupAge"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 24
              },
              {
                "content": {
                  "$ref": "#/spec/panels/backupState"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 24
              }
            ]
          }
        }
      ],
      "panels": {
        "attachment": {
          "spec": {
            "display": {
              "description": "How many volumes are attached, detached or changing state. Detached can be normal for stopped VMs and does not mean that a disk should be deleted.\n\nMeasurement details:\nSum of deduplicated 0/1 attachment-state gauges by cluster and state. Not a deletion list. Missing source metrics remain empty.",
              "name": "Volume count by attachment state"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 0,
                    "unit": "decimal"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${state}",
                      "query": "sum by (k8s_cluster_name,state) (max by (k8s_cluster_name,volume,state) (longhorn_volume_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}))"
                    }
                  }
                }
              }
            ]
          }
        },
        "backupAge": {
          "spec": {
            "display": {
              "description": "Age of each non-zero last-backup timestamp. Missing data can mean no recorded backup; check the separate count above.\n\nMeasurement details:\ntime() minus the non-zero Unix timestamp, divided by 86400. Empty may mean no backup; see the never-backed-up tile. Does not verify target accessibility or restore.",
              "name": "Days since the last successful backup"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "decimal"
                  },
                  "label": "Days",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume}",
                      "query": "(time() - (max by (k8s_cluster_name,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) > 0)) / 86400"
                    }
                  }
                }
              }
            ]
          }
        },
        "backupState": {
          "spec": {
            "display": {
              "description": "Number of backup records in each status. Completed is metadata from Longhorn; it does not verify backup accessibility or a successful restore.\n\nMeasurement details:\nLonghorn 1.11.2 codes are counted and named: 0 New, 1 Pending, 2 In progress, 3 Completed, 4 Error, 5 Unknown. Zeros appear only when backup-state metrics exist.",
              "name": "Backup count by status"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 0,
                    "unit": "decimal"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · New",
                      "query": "count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 0) or on (k8s_cluster_name) (0 * count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · Pending",
                      "query": "count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 1) or on (k8s_cluster_name) (0 * count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · In progress",
                      "query": "count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 2) or on (k8s_cluster_name) (0 * count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · Completed",
                      "query": "count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 3) or on (k8s_cluster_name) (0 * count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · Error",
                      "query": "count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 4) or on (k8s_cluster_name) (0 * count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · Unknown",
                      "query": "count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 5) or on (k8s_cluster_name) (0 * count by (k8s_cluster_name) (max by (k8s_cluster_name,volume,backup) (longhorn_backup_state{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              }
            ]
          }
        },
        "guide": {
          "spec": {
            "display": {
              "description": "Which volumes need attention, how busy is storage, and what backups are recorded?",
              "name": "What this dashboard tells you"
            },
            "links": [],
            "plugin": {
              "kind": "Markdown",
              "spec": {
                "text": "**Which volumes need attention, how busy is storage, and what backups are recorded?** Start with volume health, then check storage space and backups. A volume is a virtual disk; this view includes all selected Longhorn volumes, including non-VM volumes. A recorded backup does not prove that a restore will succeed. **No data is not the same as zero.** Use the description icon for measurement details."
              }
            },
            "queries": []
          }
        },
        "iops": {
          "spec": {
            "display": {
              "description": "Read and write operations per second reported by Longhorn. More activity is not automatically a problem; compare with response time.\n\nMeasurement details:\nRead/write operations per second are already gauges computed by Longhorn. Do not take a second rate.",
              "name": "Storage read and write operations (operations/s)"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "decimal"
                  },
                  "label": "Operations per second",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume} · read",
                      "query": "max by (k8s_cluster_name,volume) (longhorn_volume_read_iops{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume} · write",
                      "query": "max by (k8s_cluster_name,volume) (longhorn_volume_write_iops{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})"
                    }
                  }
                }
              }
            ]
          }
        },
        "latency": {
          "spec": {
            "display": {
              "description": "Current average response time reported by Longhorn for active volumes, in milliseconds. Compare with VM disk latency to locate storage delays.\n\nMeasurement details:\nLonghorn exposes current latency gauges in nanoseconds. Divide by 1,000,000; do not apply rate(). Filter zero-IOPS volumes out because idle latency has no operational meaning.",
              "name": "Time to read or write a storage volume (ms)"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "milliseconds"
                  },
                  "label": "Milliseconds",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume} · read",
                      "query": "(max by (k8s_cluster_name,volume) (longhorn_volume_read_latency{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) / 1000000) and (max by (k8s_cluster_name,volume) (longhorn_volume_read_iops{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) > 0)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume} · write",
                      "query": "(max by (k8s_cluster_name,volume) (longhorn_volume_write_latency{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) / 1000000) and (max by (k8s_cluster_name,volume) (longhorn_volume_write_iops{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) > 0)"
                    }
                  }
                }
              }
            ]
          }
        },
        "logicalCapacity": {
          "spec": {
            "display": {
              "description": "Provisioned logical capacity of each volume. Physical usage depends on written data, snapshots and replicas.\n\nMeasurement details:\nLogical provisioned size, independent of physical bytes used and replica count.",
              "name": "Size assigned to each volume"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "bytes(IEC)"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume}",
                      "query": "max by (k8s_cluster_name,volume) (longhorn_volume_capacity_bytes{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})"
                    }
                  }
                }
              }
            ]
          }
        },
        "neverBackup": {
          "spec": {
            "display": {
              "description": "Volumes whose last successful backup timestamp is zero. Check which ones actually need backups; this includes non-VM volumes.\n\nMeasurement details:\nLast successful backup timestamp equals zero. Includes all selected volumes, not just VM disks. Check which volumes require protection before scheduling backups.",
              "name": "Volumes with no recorded backup"
            },
            "links": [],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 0,
                  "unit": "none"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "Volumes",
                      "query": "count(max by (k8s_cluster_name,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 0) or (0 * count(max by (k8s_cluster_name,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              }
            ]
          }
        },
        "neverBackupDetails": {
          "spec": {
            "display": {
              "description": "Up to 5 volumes with no successful backup timestamp. Each entry identifies the PVC and Longhorn volume; 1 means no recorded backup. Open the values table for the complete list, then compare it with your backup policy.\n\nMeasurement details:\nLatest matching observations, deduplicated by cluster, PVC namespace, PVC and volume. PVC metadata can be empty for volumes without a claim. The PVC namespace is not the longhorn-system namespace of the collector. No matching series is not proof of health: check the summary and collection first. Hover for full names or open the values table. No VM association is inferred from a namespace.",
              "name": "Which volumes have no recorded backup?"
            },
            "links": [
              {
                "name": "Open values table",
                "targetBlank": true,
                "tooltip": "All matching resources, including those outside Top 5. Select Table view and check the time range. Units and conditions are explained in the panel description.",
                "url": "./#/metrics?metrics=[[[\"last_over_time(((max by (k8s_cluster_name,pvc_namespace,pvc,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\\\"${storage_cluster}\\\",volume=~\\\"${storage_volume}\\\"}) == 0) \\u002b 1)[1s:1s] @ end())\"]],[0,[6,[true,\"\"]]]]"
              }
            ],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 0,
                  "unit": "none"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#E5A000",
                  "steps": []
                },
                "valueFontSize": 20
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume} · ${pvc_namespace}/${pvc} · ${k8s_cluster_name}",
                      "query": "topk(5, last_over_time(((max by (k8s_cluster_name,pvc_namespace,pvc,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) == 0) + 1)[1s:1s] @ end()))"
                    }
                  }
                }
              }
            ]
          }
        },
        "physicalStorage": {
          "spec": {
            "display": {
              "description": "Longhorn-managed capacity, used space and reserved space on each host. Includes all volumes in the cluster, regardless of the volume filter.\n\nMeasurement details:\nLonghorn-managed node capacity, used bytes and reserved bytes for other applications/system. Cluster scope: volume filter does not apply. Scheduled bytes are a different measure.",
              "name": "Physical storage used and available capacity"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "bytes(IEC)"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${node} · capacity",
                      "query": "max by (k8s_cluster_name,node) (longhorn_node_storage_capacity_bytes{k8s_cluster_name=~\"${storage_cluster}\"})"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${node} · usage",
                      "query": "max by (k8s_cluster_name,node) (longhorn_node_storage_usage_bytes{k8s_cluster_name=~\"${storage_cluster}\"})"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${node} · reservation",
                      "query": "max by (k8s_cluster_name,node) (longhorn_node_storage_reservation_bytes{k8s_cluster_name=~\"${storage_cluster}\"})"
                    }
                  }
                }
              }
            ]
          }
        },
        "scheduledStorage": {
          "spec": {
            "display": {
              "description": "Logical capacity scheduled for Longhorn replicas. Thin provisioning can make this exceed physical capacity; it is different from bytes already written.\n\nMeasurement details:\nLogical bytes scheduled as replicas. Can exceed physical capacity with thin provisioning; do not subtract this from physical usage to calculate free disk.",
              "name": "Disk capacity promised to replicas"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "bytes(IEC)"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${node}",
                      "query": "max by (k8s_cluster_name,node) (longhorn_node_storage_scheduled_bytes{k8s_cluster_name=~\"${storage_cluster}\"})"
                    }
                  }
                }
              }
            ]
          }
        },
        "snapshotSpace": {
          "spec": {
            "display": {
              "description": "Sum of reported snapshot sizes for each volume. Shared data and replicas mean this is not physical space usage or guaranteed reclaimable space.\n\nMeasurement details:\nSum reported snapshot sizes, deduplicated by volume/snapshot. This is not physical replicated disk usage or guaranteed reclaimable space; sharing, rebuilds and purge behavior matter.",
              "name": "Reported snapshot data per volume"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "bytes(IEC)"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume}",
                      "query": "sum by (k8s_cluster_name,volume) (max by (k8s_cluster_name,volume,snapshot) (longhorn_snapshot_actual_size_bytes{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}))"
                    }
                  }
                }
              }
            ]
          }
        },
        "staleBackup": {
          "spec": {
            "display": {
              "description": "Volumes with a successful backup older than seven days. Compare this review window with your own recovery requirement; never-backed-up volumes appear separately.\n\nMeasurement details:\nCounts only non-zero last-backup timestamps older than 7 days. Never-backed-up volumes are shown separately. The 7-day review window is not your agreed RPO.",
              "name": "Volumes last backed up over 7 days ago"
            },
            "links": [],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 0,
                  "unit": "none"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "Volumes",
                      "query": "count(((time() - (max by (k8s_cluster_name,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}))) > 604800) and (max by (k8s_cluster_name,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) > 0)) or (0 * count(max by (k8s_cluster_name,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"})))"
                    }
                  }
                }
              }
            ]
          }
        },
        "staleBackupDetails": {
          "spec": {
            "display": {
              "description": "Days since the last recorded successful backup, with PVC and volume names. Up to 5 oldest entries; open the values table for all matches. Check the backup schedule and destination against your recovery requirement.\n\nMeasurement details:\nLatest matching observations, deduplicated by cluster, PVC namespace, PVC and volume. PVC metadata can be empty for volumes without a claim. The PVC namespace is not the longhorn-system namespace of the collector. No matching series is not proof of health: check the summary and collection first. Hover for full names or open the values table. No VM association is inferred from a namespace.",
              "name": "Which backups are older than 7 days?"
            },
            "links": [
              {
                "name": "Open values table",
                "targetBlank": true,
                "tooltip": "All matching resources, including those outside Top 5. Select Table view and check the time range. Units and conditions are explained in the panel description.",
                "url": "./#/metrics?metrics=[[[\"last_over_time((((time() - (max by (k8s_cluster_name,pvc_namespace,pvc,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\\\"${storage_cluster}\\\",volume=~\\\"${storage_volume}\\\"}) \\u003e 0)) / 86400) \\u003e 7)[1s:1s] @ end())\"]],[0,[6,[true,\"\"]]]]"
              }
            ],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 1,
                  "unit": "none"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#E5A000",
                  "steps": []
                },
                "valueFontSize": 20
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${volume} · ${pvc_namespace}/${pvc} · ${k8s_cluster_name}",
                      "query": "topk(5, last_over_time((((time() - (max by (k8s_cluster_name,pvc_namespace,pvc,volume) (longhorn_volume_last_backup_at{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\"}) > 0)) / 86400) > 7)[1s:1s] @ end()))"
                    }
                  }
                }
              }
            ]
          }
        },
        "unhealthy": {
          "spec": {
            "display": {
              "description": "Volumes marked degraded or faulted by Longhorn. Open Longhorn to inspect replicas and scheduling; detached volumes with unknown health are counted separately in the health chart.\n\nMeasurement details:\nCount of unique volumes with an active degraded/faulted state. Detached unknown is not counted as healthy or unhealthy here. Zero is shown only when robustness telemetry exists.",
              "name": "Volumes needing attention"
            },
            "links": [],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 0,
                  "unit": "none"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": [
                    {
                      "color": "#E5A000",
                      "value": 1
                    }
                  ]
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "Volumes",
                      "query": "count(max by (k8s_cluster_name,volume) (longhorn_volume_robustness{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\",state=~\"degraded|faulted\"}) == 1) or (0 * count(max by (k8s_cluster_name,volume) (longhorn_volume_robustness{k8s_cluster_name=~\"${storage_cluster}\",volume=~\"${storage_volume}\",state=~\"degraded|faulted\"})))"
                    }
                  }
                }
              }
            ]
          }
        },
        "unhealthyDetails": {
          "spec": {
            "display": {
              "description": "Up to 5 volumes degraded or faulted at the end of the selected period. Each entry names the PVC and Longhorn volume; 1 means that state is active. Check replicas and scheduling in Longhorn. Open the values table for every affected volume.\n\nMeasurement details:\nLatest matching observations, deduplicated by cluster, PVC namespace, PVC and volume. PVC metadata can be empty for volumes without a claim. The PVC namespace is not the longhorn-system namespace of the collector. No matching series is not proof of health: check the summary and collection first. Hover for full names or open the values table. No VM association is inferred from a namespace.",
              "name": "Which volumes need attention?"
            },
            "links": [
              {
