nodes:
- _type: Monitor
  name: SRE · etcd telemetry disappeared · 5m
  identifier: urn:custom:monitor:sre-dashboards:etcd-telemetry-missing
  description: Checks etcd telemetry disappeared · 5m. Values are evaluated every
    60 seconds. Windows apply to observed samples; inspect collection health before
    interpreting a missing result. Thresholds are starting points to review against
    the workload baseline.
  arguments:
    metric:
      query: min_over_time((((max by (cluster_name,node) (last_over_time(up{job="sre-etcd"}[24h]))
        * 0 + 1) unless on (cluster_name,node) (max by (cluster_name,node) (up{job="sre-etcd"}
        == 1))) or on (cluster_name,node) ((max by (cluster_name,node) (last_over_time(up{job="sre-etcd"}[24h]))
        * 0 + 1) * 0))[5m:30s])
      unit: none
      aliasTemplate: ${cluster_name} · ${node}
    comparator: GT
    threshold: 0
    failureState: CRITICAL
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · etcd telemetry disappeared · 5m · ${cluster_name} · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Identify the cluster and node in the title. Check etcd quorum
    and peer connectivity.

    2. Compare leader changes, WAL writes, database commits, peer round trips, pod
    restarts and previous logs at the same time.

    3. Preserve snapshots before recovery. Never remove a member or restore a snapshot
    based on this alert alone.'
  tags:
  - sre-dashboards
  - dashboard-platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
