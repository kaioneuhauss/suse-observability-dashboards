{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["observability", "auth", "runner", "dashboards"],
  "properties": {
    "observability": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://", "minLength": 9}
      }
    },
    "auth": {
      "type": "object",
      "required": ["existingSecret", "serviceTokenKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "serviceTokenKey": {"type": "string", "minLength": 1}
      }
    },
    "runner": {
      "type": "object",
      "required": ["image", "cli", "activeDeadlineSeconds", "ttlSecondsAfterFinished", "resources"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"]
        },
        "cli": {
          "type": "object",
          "required": ["version", "downloadUrl"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "downloadUrl": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        },
        "activeDeadlineSeconds": {"type": "integer", "minimum": 60},
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0},
        "resources": {"type": "object"}
      }
    },
    "dashboards": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "traefikMetrics": {
      "type": "object",
      "required": ["enabled", "clusterName", "workloadNamespace", "selector", "targetPort", "port", "scrapeInterval", "remoteWriteUrl", "image", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "clusterName": {"type": "string"},
        "workloadNamespace": {"type": "string", "minLength": 1},
        "selector": {"type": "object", "minProperties": 1},
        "targetPort": {"oneOf": [{"type": "string"}, {"type": "integer"}]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "scrapeInterval": {"type": "string", "pattern": "^[0-9]+[smh]$"},
        "remoteWriteUrl": {"type": "string"},
        "image": {"type": "object"},
        "resources": {"type": "object"}
      }
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"}
  }
}
