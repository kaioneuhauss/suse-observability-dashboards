nodes:
- _type: Monitor
  name: SRE · etcd leader changes above 3 in 15m
  identifier: urn:custom:monitor:sre-dashboards:etcd-elections
  description: Condição persistente por 5m; limiar inicial de diagnóstico, ajustável
    ao baseline.
  arguments:
    metric:
      query: min_over_time((max by (cluster_name,node) (increase(etcd_server_leader_changes_seen_total{job="sre-etcd"}[15m])))[5m:30s])
      unit: none
      aliasTemplate: ${node}
    comparator: GT
    threshold: 3
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · etcd leader changes above 3 in 15m · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Confira quorum, membros e conectividade.

    2. Correlacione eleições, fsync, commits, RTT, logs anteriores e reinícios.

    3. Preserve snapshots antes de qualquer recuperação.'
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
