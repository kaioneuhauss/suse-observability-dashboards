nodes:
- _type: Monitor
  name: SRE · metric collector discarded data · 15m
  identifier: urn:custom:monitor:sre-dashboards:collector-dropped
  description: Qualquer descarte observado de amostras ou bytes da fila merece investigação.
    O valor é apenas detector combinado, não uma unidade de volume.
  arguments:
    metric:
      query: max by (cluster_name,node,collector_kind) (increase(vmagent_remotewrite_samples_dropped_total{job="sre-collector",node!=""}[15m]))
        + max by (cluster_name,node,collector_kind) (increase(vm_persistentqueue_bytes_dropped_total{job="sre-collector",node!=""}[15m]))
      unit: none
      aliasTemplate: ${node} · ${collector_kind}
    comparator: GT
    threshold: 0
    failureState: CRITICAL
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · metric collector discarded data · 15m · ${node} · ${collector_kind}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Verifique receiver, fila, retenção do buffer e reinícios. Os dados
    descartados não são recuperados automaticamente.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
