nodes:
- _type: Monitor
  name: SRE · container working set above 95 percent limit · 5m
  identifier: urn:custom:monitor:sre-dashboards:container-memory
  description: Risco de OOM em containers comuns; exclui virt-launcher, que tem monitor
    de RAM disponível no guest. Working set não é heap.
  arguments:
    metric:
      query: min_over_time((max by (cluster_name,namespace,pod_name,container) (container_memory_working_set{pod_name!~"virt-launcher-.*"})
        / (max by (cluster_name,namespace,pod_name,container) (kubernetes_state_container_memory_limit)
        > 0))[5m:30s])
      unit: none
      aliasTemplate: ${container}
    comparator: GT
    threshold: 0.95
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:${namespace}:pod/${pod_name}
    titleTemplate: SRE · container working set above 95 percent limit · 5m · ${container}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Colete Last State, probes, logs --previous, RSS/cache/heap e eventos.
    Compare o mesmo container e instante. Working set não é heap. Diagnostique antes
    de ajustar recursos.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
