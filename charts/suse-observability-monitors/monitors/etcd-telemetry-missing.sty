nodes:
- _type: Monitor
  name: SRE · etcd telemetry disappeared · 5m
  identifier: urn:custom:monitor:sre-dashboards:etcd-telemetry-missing
  description: Membro coletado nas últimas 24h sem target saudável por cinco minutos.
    Não descobre membros que nunca foram coletados.
  arguments:
    metric:
      query: min_over_time((((max by (cluster_name,node) (last_over_time(up{job="sre-etcd"}[24h]))
        * 0 + 1) unless on (cluster_name,node) (max by (cluster_name,node) (up{job="sre-etcd"}
        == 1))) or on (cluster_name,node) ((max by (cluster_name,node) (last_over_time(up{job="sre-etcd"}[24h]))
        * 0 + 1) * 0))[5m:30s])
      unit: none
      aliasTemplate: ${node}
    comparator: GT
    threshold: 0
    failureState: CRITICAL
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · etcd telemetry disappeared · 5m · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Confira o DaemonSet etcd, labels dos nós, DNS e envio. Compare
    com a topologia esperada; membros removidos exigem interpretação do histórico.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
