nodes:
- _type: Monitor
  name: SRE · filesystem below 10 percent available · 15m
  identifier: urn:custom:monitor:sre-dashboards:node-space
  description: Menos de 10% disponível em todas as amostras dos últimos 15 minutos.
    Exclui imagens loop, filesystems temporários e montagens de pods. Não equivale
    ao espaço livre dentro de uma VM.
  arguments:
    metric:
      query: max_over_time((max by (cluster_name,node,device,mountpoint) (node_filesystem_avail_bytes{job="sre-node",device!~"/dev/loop[0-9]+",mountpoint!~"/var/lib/kubelet/.*",fstype!~"tmpfs|overlay|squashfs"})
        / max by (cluster_name,node,device,mountpoint) (node_filesystem_size_bytes{job="sre-node",device!~"/dev/loop[0-9]+",mountpoint!~"/var/lib/kubelet/.*",fstype!~"tmpfs|overlay|squashfs"}))[15m:30s])
      unit: none
      aliasTemplate: ${mountpoint} · ${device}
    comparator: LT
    threshold: 0.1
    failureState: CRITICAL
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · filesystem below 10 percent available · 15m · ${mountpoint}
      · ${device}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Confira o dispositivo e a montagem com df -h e df -i no nó afetado.
    Identifique crescimento de logs, imagens e arquivos pequenos. Verifique retenção
    e capacidade antes de remover dados. Para Harvester, diferencie a partição persistente
    da partição de dados Longhorn.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
