nodes:
- _type: Monitor
  name: SRE · metric collection backlog persists · 10m
  identifier: urn:custom:monitor:sre-dashboards:collector-backlog
  description: Fila dos coletores de nó/etcd positiva em todas as amostras por dez
    minutos. Pequenos picos não disparam.
  arguments:
    metric:
      query: min_over_time((max by (cluster_name,node,collector_kind) (vmagent_remotewrite_pending_data_bytes{job="sre-collector",node!=""}))[10m:30s])
      unit: none
      aliasTemplate: ${node} · ${collector_kind}
    comparator: GT
    threshold: 0
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · metric collection backlog persists · 10m · ${node} · ${collector_kind}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Verifique DNS, TLS, status HTTP do receiver e espaço da fila. A
    série também deixa de chegar durante indisponibilidade total; use cobertura e
    sinais do próprio SUSE em conjunto.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
