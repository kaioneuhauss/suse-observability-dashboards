nodes:
- _type: Monitor
  name: SRE · VM guest OS below 10 percent available RAM · 15m
  identifier: urn:custom:monitor:sre-dashboards:vm-guest-memory
  description: Condição persistente calculada na consulta. Limiar de diagnóstico ajustável
    ao ambiente. Investigue coleta ausente separadamente.
  arguments:
    metric:
      query: label_replace(max_over_time((max by (k8s_cluster_name,namespace,name,node)
        (kubevirt_vmi_memory_usable_bytes) / max by (k8s_cluster_name,namespace,name,node)
        (kubevirt_vmi_memory_available_bytes))[15m:30s]), "cluster_name", "$1", "k8s_cluster_name",
        "(.*)")
      unit: none
      aliasTemplate: ${namespace} · ${name}
    comparator: LT
    threshold: 0.1
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · VM guest OS below 10 percent available RAM · 15m · ${namespace}
      · ${name}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Confira RAM disponível, balloon, QEMU Guest Agent e pressão no
    SO guest. Compare requests/limits do domínio separadamente do consumo do guest.
    O residente QEMU não equivale a RAM usada dentro da VM.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
