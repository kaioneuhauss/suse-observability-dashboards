nodes:
- _type: Monitor
  name: SRE · Ingress inventory collection failing · 3m
  identifier: urn:custom:monitor:sre-dashboards:ingress-inventory
  description: O mapeamento de namespace/Service/porta nomeada não está sendo atualizado.
    O endpoint usa somente list de Ingress.
  arguments:
    metric:
      query: (max_over_time((min by (cluster_name) (sre_ingress_inventory_success))[3m:30s]))
        * on (cluster_name) group_left(namespace,daemonset) (max by (cluster_name,namespace,daemonset)
        (kubernetes_state_daemonset_desired{daemonset=~".*traefik.*"}) * 0 + 1)
      unit: none
      aliasTemplate: ${daemonset}
    comparator: LT
    threshold: 1
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:${namespace}:daemonset/${daemonset}
    titleTemplate: SRE · Ingress inventory collection failing · 3m · ${daemonset}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Confira logs do container ingress-inventory, RBAC list ingresses,
    CA e acesso à API Kubernetes. Em ambientes com mais de um Traefik por cluster
    adapte o vínculo de topologia.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
