nodes:
- _type: Monitor
  name: SRE · etcd database above 80 percent quota
  identifier: urn:custom:monitor:sre-dashboards:etcd-quota
  description: Condição persistente por 10m; limiar inicial de diagnóstico, ajustável
    ao baseline.
  arguments:
    metric:
      query: min_over_time((max by (cluster_name,node) (etcd_mvcc_db_total_size_in_bytes{job="sre-etcd"})
        / max by (cluster_name,node) (etcd_server_quota_backend_bytes{job="sre-etcd"}))[10m:30s])
      unit: none
      aliasTemplate: ${node}
    comparator: GT
    threshold: 0.8
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · etcd database above 80 percent quota · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Confira quorum, membros e conectividade.

    2. Correlacione eleições, fsync, commits, RTT, logs anteriores e reinícios.

    3. Preserve snapshots antes de qualquer recuperação.'
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
