nodes:
- _type: Monitor
  name: SRE · etcd without leader · 1m
  identifier: urn:custom:monitor:sre-dashboards:etcd-no-leader
  description: Crítico quando um membro não enxerga líder durante 1 minuto. Coleta
    ausente tem monitor separado.
  arguments:
    metric:
      query: max_over_time((max by (cluster_name,node) (etcd_server_has_leader{job="sre-etcd"}))[1m:30s])
      unit: none
      aliasTemplate: ${node}
    comparator: LT
    threshold: 1
    failureState: CRITICAL
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · etcd without leader · 1m · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Confira quorum, membros e conectividade.

    2. Correlacione eleições, fsync, commits, RTT, logs anteriores e reinícios.

    3. Preserve snapshots antes de qualquer recuperação.'
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
