nodes:
- _type: Monitor
  name: SRE · missing node OS telemetry · 5m
  identifier: urn:custom:monitor:sre-dashboards:node-telemetry
  description: Condição persistente calculada na consulta. Limiar de diagnóstico ajustável
    ao ambiente. Investigue coleta ausente separadamente.
  arguments:
    metric:
      query: min_over_time((((max by (cluster_name,node) (kubernetes_state_node_age)
        * 0 + 1) unless on (cluster_name,node) (max by (cluster_name,node) (up{job="sre-node"}
        == 1))) or on (cluster_name,node) (max by (cluster_name,node) (kubernetes_state_node_age)
        * 0))[5m:30s])
      unit: none
      aliasTemplate: ${node}
    comparator: GT
    threshold: 0
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · missing node OS telemetry · 5m · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Confira DaemonSet, taints, tolerations, logs do vmagent, Secret
    de ingestão e conectividade do receiver. Compare os targets com o inventário de
    nós.
  tags:
  - sre-dashboards
  - platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
