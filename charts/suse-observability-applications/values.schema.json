{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "clusterName",
    "observability",
    "ingestion",
    "auth",
    "lifecycle",
    "slo",
    "content",
    "applicationMetrics"
  ],
  "properties": {
    "observability": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://[^ /]+(/.*)?$"
        },
        "remoteWriteUrl": {
          "type": "string",
          "pattern": "^(https://[^ ]+)?$"
        },
        "otlpEndpoint": {
          "type": "string"
        }
      }
    },
    "ingestion": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "required": [
        "dashboards",
        "monitors"
      ],
      "properties": {
        "dashboards": {
          "type": "object",
          "required": [
            "existingSecret",
            "serviceTokenKey"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "serviceTokenKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "monitors": {
          "type": "object",
          "required": [
            "existingSecret",
            "serviceTokenKey"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1
            },
            "serviceTokenKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "apply",
            "plan",
            "delete"
          ]
        },
        "confirmDelete": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      }
    },
    "slo": {
      "type": "object",
      "properties": {
        "availabilityTarget": {
          "type": "number",
          "minimum": 1,
          "exclusiveMaximum": 100
        }
      },
      "required": [
        "availabilityTarget"
      ]
    },
    "content": {
      "type": "object",
      "required": [
        "publisher"
      ],
      "properties": {
        "publisher": {
          "type": "object",
          "properties": {
            "cli": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "downloadUrl": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^([a-fA-F0-9]{64})?$"
                }
              }
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "ttlSecondsAfterFinished": {
              "type": "integer",
              "minimum": 60
            },
            "resources": {
              "type": "object",
              "required": [
                "requests",
                "limits"
              ],
              "properties": {
                "requests": {
                  "type": "object",
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$",
                          "not": {
                            "pattern": "^0+(?:\\.0+)?(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$"
                          }
                        }
                      ]
                    },
                    "memory": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$",
                          "not": {
                            "pattern": "^0+(?:\\.0+)?(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$"
                          }
                        }
                      ]
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$",
                          "not": {
                            "pattern": "^0+(?:\\.0+)?(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$"
                          }
                        }
                      ]
                    },
                    "memory": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$",
                          "not": {
                            "pattern": "^0+(?:\\.0+)?(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "required": [
            "resources"
          ]
        },
        "dashboards": {
          "type": "object",
          "required": [
            "enabled",
            "include",
            "updateStrategy"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "include": {
              "const": [
                "applications"
              ]
            },
            "updateStrategy": {
              "enum": [
                "patch",
                "replace"
              ]
            }
          }
        },
        "monitors": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "include": {
              "const": [
                "app-http-errors",
                "app-http-latency"
              ]
            }
          }
        }
      }
    },
    "applicationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestCounter",
        "durationHistogram",
        "clusterLabel",
        "serviceLabel",
        "statusLabel",
        "routeLabel"
      ],
      "properties": {
        "requestCounter": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_:]*$"
        },
        "durationHistogram": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_:]*$"
        },
        "clusterLabel": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_:]*$"
        },
        "serviceLabel": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_:]*$"
        },
        "statusLabel": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_:]*$"
        },
        "routeLabel": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_:]*$"
        }
      }
    },
    "mode": {
      "enum": [
        "content"
      ]
    },
    "clusterName": {
      "type": "string"
    }
  }
}
