nodes:
- _type: Monitor
  name: SRE · filesystem below 10 percent free inodes · 15m
  identifier: urn:custom:monitor:sre-dashboards:node-inodes
  description: Checks filesystem below 10 percent free inodes · 15m. Values are evaluated
    every 60 seconds. Windows apply to observed samples; inspect collection health
    before interpreting a missing result. Thresholds are starting points to review
    against the workload baseline.
  arguments:
    metric:
      query: max_over_time((max by (cluster_name,node,device) (node_filesystem_files_free{job="sre-node",device!~"/dev/loop[0-9]+",mountpoint!~"/var/lib/kubelet/.*",fstype!~"tmpfs|overlay|squashfs"})
        / (max by (cluster_name,node,device) (node_filesystem_files{job="sre-node",device!~"/dev/loop[0-9]+",mountpoint!~"/var/lib/kubelet/.*",fstype!~"tmpfs|overlay|squashfs"})
        > 0))[15m:30s])
      unit: none
      aliasTemplate: ${cluster_name} · ${node} · ${device}
    comparator: LT
    threshold: 0.1
    failureState: CRITICAL
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · filesystem below 10 percent free inodes · 15m · ${cluster_name}
      · ${node} · ${device}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Locate the cluster and resource named in the alert. Compare
    the reported metric with the guest OS or Kubernetes API.

    2. Review the same time window for workload changes, limits, restarts and storage
    or memory pressure.

    3. Apply a workload-specific correction and verify recovery; do not delete data
    or raise limits automatically.'
  tags:
  - sre-dashboards
  - dashboard-platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
