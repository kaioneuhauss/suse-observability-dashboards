nodes:
- _type: Monitor
  name: SRE · VM disk response above 20ms · 10m
  identifier: urn:custom:monitor:sre-dashboards:vm-disk-latency
  description: Combined virtual disk read/write response exceeds 20 ms over observed
    10-minute samples with at least 1 operation/s. Idle and cloud-init disks are excluded.
    This initial threshold needs a workload baseline. Health is attached to the host;
    the title identifies VM and drive.
  arguments:
    metric:
      query: min_over_time((((max by(k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_read_times_seconds_total{drive!~".*(cloudinit|cdrom).*"}[5m]))+max
        by(k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_write_times_seconds_total{drive!~".*(cloudinit|cdrom).*"}[5m])))/((max
        by(k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_iops_read_total{drive!~".*(cloudinit|cdrom).*"}[5m]))+max
        by(k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_iops_write_total{drive!~".*(cloudinit|cdrom).*"}[5m])))
        >= 1))*1000 * on(k8s_cluster_name,namespace,name) group_left(cluster_name,node)
        (label_replace(max by(k8s_cluster_name,namespace,name,node) (kubevirt_vmi_info{phase="running"}),
        "cluster_name", "$1", "k8s_cluster_name", "(.*)")))[10m:30s])
      unit: none
      aliasTemplate: ${cluster_name} · ${namespace} · ${name} · ${drive}
    comparator: GT
    threshold: 20
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · VM disk response above 20ms · 10m · ${cluster_name} · ${namespace}
      · ${name} · ${drive}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Compare VM read/write times and IOPS with host disk response, queues
    and Longhorn volume/replica health. Check guest load and snapshots at the same
    time. This does not identify the faulty physical disk by itself.
  tags:
  - sre-dashboards
  - dashboard-harvester
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
