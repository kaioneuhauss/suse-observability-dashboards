nodes:
- _type: Monitor
  name: SRE · Ingress inventory collection failing · 3m
  identifier: urn:custom:monitor:sre-dashboards:ingress-inventory
  description: Checks Ingress inventory collection failing · 3m. Values are evaluated
    every 60 seconds. Windows apply to observed samples; inspect collection health
    before interpreting a missing result. Thresholds are starting points to review
    against the workload baseline.
  arguments:
    metric:
      query: (max_over_time((min by (cluster_name) (sre_ingress_inventory_success))[3m:30s]))
        * on (cluster_name) group_left(namespace,daemonset) (max by (cluster_name,namespace,daemonset)
        (kubernetes_state_daemonset_desired{daemonset=~".*traefik.*"}) * 0 + 1)
      unit: none
      aliasTemplate: ${cluster_name} · ${namespace}
    comparator: LT
    threshold: 1
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:${namespace}:daemonset/${daemonset}
    titleTemplate: SRE · Ingress inventory collection failing · 3m · ${cluster_name}
      · ${namespace}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Check the collector pod, readiness, recent and previous logs.

    2. Verify DNS, TLS, NetworkPolicy, endpoint reachability, ingestion credentials
    and remote-write responses.

    3. Check queue growth and dropped samples. A running pod does not prove successful
    delivery.'
  tags:
  - sre-dashboards
  - dashboard-traefik
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
