{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "clusterName",
    "remoteWrite",
    "etcd"
  ],
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1
    },
    "remoteWrite": {
      "type": "object",
      "required": [
        "url",
        "existingSecret",
        "secretKey"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "forcePrometheusProtocol": {
          "type": "boolean"
        }
      }
    },
    "etcd": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "pattern": "^http://127[.]0[.]0[.]1:[0-9]+/metrics$"
        },
        "nodeSelector": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "vmagent": {
      "type": "object",
      "required": [
        "queueMaxDiskMiB",
        "selfMonitoring"
      ],
      "properties": {
        "queueMaxDiskMiB": {
          "type": "integer",
          "minimum": 513
        },
        "selfMonitoring": {
          "type": "boolean"
        }
      }
    }
  }
}
