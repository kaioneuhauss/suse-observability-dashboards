{
  "dashboard": {
    "metadata": {
      "project": "{\"saveVariables\":false}"
    },
    "spec": {
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "items": [
              {
                "content": {
                  "$ref": "#/spec/panels/guide"
                },
                "height": 1,
                "width": 24,
                "x": 0,
                "y": 0
              },
              {
                "content": {
                  "$ref": "#/spec/panels/cpuReady"
                },
                "height": 1,
                "width": 8,
                "x": 0,
                "y": 1
              },
              {
                "content": {
                  "$ref": "#/spec/panels/cpuUsage"
                },
                "height": 1,
                "width": 8,
                "x": 8,
                "y": 1
              },
              {
                "content": {
                  "$ref": "#/spec/panels/memoryUse"
                },
                "height": 1,
                "width": 8,
                "x": 16,
                "y": 1
              },
              {
                "content": {
                  "$ref": "#/spec/panels/ready"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 2
              },
              {
                "content": {
                  "$ref": "#/spec/panels/cpu"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 2
              },
              {
                "content": {
                  "$ref": "#/spec/panels/ioWait"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 5
              },
              {
                "content": {
                  "$ref": "#/spec/panels/memory"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 5
              },
              {
                "content": {
                  "$ref": "#/spec/panels/faults"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 8
              },
              {
                "content": {
                  "$ref": "#/spec/panels/swap"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 8
              },
              {
                "content": {
                  "$ref": "#/spec/panels/readLatency"
                },
                "height": 3,
                "width": 12,
                "x": 0,
                "y": 11
              },
              {
                "content": {
                  "$ref": "#/spec/panels/writeLatency"
                },
                "height": 3,
                "width": 12,
                "x": 12,
                "y": 11
              }
            ]
          }
        }
      ],
      "panels": {
        "cpu": {
          "spec": {
            "display": {
              "description": "CPU demand as a percentage of configured virtual CPUs. High use can be productive work; CPU waiting time provides the contention context.\n\nMeasurement details:\nCPU demand relative to configured VM topology, not Kubernetes CPU request.",
              "name": "CPU used by each VM"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "100 * (max by (k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_cpu_usage_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))) / ((max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"cores\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"sockets\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"threads\"})) > 0)"
                    }
                  }
                }
              }
            ]
          }
        },
        "cpuReady": {
          "spec": {
            "display": {
              "description": "Highest average CPU scheduling wait among selected VMs. A sustained increase means virtual CPUs are waiting for processing time on the host.\n\nMeasurement details:\nMean run-queue delay across vCPUs, then worst selected VM. A scheduling-pressure analogue to CPU Ready; not VMware-identical accounting. No factor of 1000: KubeVirt exports seconds.",
              "name": "Longest wait for CPU"
            },
            "links": [],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 1,
                  "unit": "percent"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "last_over_time((topk(1,100 * avg by (k8s_cluster_name,namespace,name) (max by (k8s_cluster_name,namespace,name,id) (rate(kubevirt_vmi_vcpu_delay_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])))))[1s:1s] @ end())"
                    }
                  }
                }
              }
            ]
          }
        },
        "cpuUsage": {
          "spec": {
            "display": {
              "description": "Highest CPU use relative to the VM's configured virtual CPUs. Compare with CPU waiting time before concluding that the host is overloaded.\n\nMeasurement details:\nDomain CPU seconds per second divided by configured cores × sockets × threads. Includes hypervisor/domain CPU accounting; inspect the time series before resizing.",
              "name": "Busiest VM: CPU used"
            },
            "links": [],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 1,
                  "unit": "percent"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "last_over_time((topk(1,100 * (max by (k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_cpu_usage_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))) / ((max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"cores\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"sockets\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"threads\"})) > 0)))[1s:1s] @ end())"
                    }
                  }
                }
              }
            ]
          }
        },
        "faults": {
          "spec": {
            "display": {
              "description": "Major page faults per second inside each VM. These reads can slow an application; compare with swap and available memory.\n\nMeasurement details:\nRate of major page faults; investigate together with swap activity and guest memory headroom.",
              "name": "Memory pages fetched from disk (pages/s)"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "decimal"
                  },
                  "label": "Pages per second",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "max by (k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_memory_pgmajfault_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))"
                    }
                  }
                }
              }
            ]
          }
        },
        "guide": {
          "spec": {
            "display": {
              "description": "Why is a virtual machine slow? Compare CPU waiting time, memory pressure and disk response.",
              "name": "What this dashboard tells you"
            },
            "links": [],
            "plugin": {
              "kind": "Markdown",
              "spec": {
                "text": "**Why is a virtual machine slow? Compare CPU waiting time, memory pressure and disk response.** Select a VM and look for changes at the same time as the slowdown. High CPU use alone does not prove a problem: also check waiting time and disk response. Most rates use the last 5 minutes. **No data is not the same as zero.** Use the description icon for measurement details."
              }
            },
            "queries": []
          }
        },
        "ioWait": {
          "spec": {
            "display": {
              "description": "Time virtual CPUs spend blocked on input/output. Compare with disk response time; it is different from waiting for a turn on the CPU.\n\nMeasurement details:\nTime blocked on I/O, distinct from runnable CPU scheduler delay.",
              "name": "Time VMs spend waiting for disk I/O"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "100 * avg by (k8s_cluster_name,namespace,name) (max by (k8s_cluster_name,namespace,name,id) (rate(kubevirt_vmi_vcpu_wait_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])))"
                    }
                  }
                }
              }
            ]
          }
        },
        "memory": {
          "spec": {
            "display": {
              "description": "Guest memory use after allowing for reclaimable memory. A rising value together with swap or page reads can indicate memory pressure.\n\nMeasurement details:\nGuest MemAvailable-based use; different from QEMU RSS and host RAM.",
              "name": "Memory used inside each VM"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "100 * (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) - max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_usable_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"})) / (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) > 0)"
                    }
                  }
                }
              }
            ]
          }
        },
        "memoryUse": {
          "spec": {
            "display": {
              "description": "Highest guest memory-use percentage. Compare with swap activity and page reads to see whether memory pressure is affecting performance.\n\nMeasurement details:\n100 × (available - usable) / available. Usable corresponds to guest MemAvailable; reclaimable cache is not counted as used. Missing statistics remain empty.",
              "name": "Busiest VM: memory used"
            },
            "links": [],
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 1,
                  "unit": "percent"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "last_over_time((topk(1,100 * (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) - max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_usable_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"})) / (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) > 0)))[1s:1s] @ end())"
                    }
                  }
                }
              }
            ]
          }
        },
        "readLatency": {
          "spec": {
            "display": {
              "description": "Average milliseconds per completed disk read. Lower is faster. Idle disks have no measured average and remain empty.\n\nMeasurement details:\nMean seconds spent on I/O divided by completed I/Os, converted to milliseconds. One series per VM disk. Idle disks have no mean latency and remain empty.",
              "name": "Time to read from a VM disk (ms)"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "milliseconds"
                  },
                  "label": "Milliseconds",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · ${drive}",
                      "query": "1000 * max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_read_times_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) / (max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_iops_read_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) > 0)"
                    }
                  }
                }
              }
            ]
          }
        },
        "ready": {
          "spec": {
            "display": {
              "description": "Average percentage of time each VM's virtual CPUs wait to be scheduled. Look for increases that coincide with a slowdown.\n\nMeasurement details:\nAverage per-vCPU scheduling delay over 5 minutes, deduplicated by VM and vCPU ID.",
              "name": "Time VMs spend waiting for CPU"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}",
                      "query": "100 * avg by (k8s_cluster_name,namespace,name) (max by (k8s_cluster_name,namespace,name,id) (rate(kubevirt_vmi_vcpu_delay_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])))"
                    }
                  }
                }
              }
            ]
          }
        },
        "swap": {
          "spec": {
            "display": {
              "description": "Estimated bytes per second moved into or out of swap. Repeated activity can indicate insufficient guest memory; a guest reset can distort the estimate.\n\nMeasurement details:\nKubeVirt exposes cumulative swap traffic as gauges. Positive 5-minute delta / 300 estimates traffic; a guest reset may invalidate this window. Not a counter rate.",
              "name": "VM swap traffic (bytes/s)"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "bytes/sec"
                  },
                  "label": "Bytes per second",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · in",
                      "query": "max by (k8s_cluster_name,namespace,name) (clamp_min(delta(kubevirt_vmi_memory_swap_in_traffic_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]),0) / 300)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · out",
                      "query": "max by (k8s_cluster_name,namespace,name) (clamp_min(delta(kubevirt_vmi_memory_swap_out_traffic_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]),0) / 300)"
                    }
                  }
                }
              }
            ]
          }
        },
        "writeLatency": {
          "spec": {
            "display": {
              "description": "Average milliseconds per completed disk write. Compare a rise with I/O wait and Longhorn storage latency.\n\nMeasurement details:\nMean seconds spent on I/O divided by completed I/Os, converted to milliseconds. One series per VM disk. Idle disks have no mean latency and remain empty.",
              "name": "Time to write to a VM disk (ms)"
            },
            "links": [],
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 1,
                    "unit": "milliseconds"
                  },
                  "label": "Milliseconds",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · ${drive}",
                      "query": "1000 * max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_write_times_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) / (max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_iops_write_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) > 0)"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "variables": [
        {
          "perseslistvariable": {
            "kind": "ListVariable",
            "spec": {
              "allowAllValue": true,
              "allowMultiple": true,
              "customAllValue": ".*",
              "defaultValue": {
                "perseslistvariabledefaultsinglevalue": {
                  "kind": "singleValue",
                  "singleValue": "{\"type\":\"Everything\"}"
                },
                "perseslistvariabledefaultslicevalues": null
              },
              "display": {
                "description": "Select one or more values. After changing a parent filter, reset the following filters to Everything.",
                "name": "Cluster"
              },
              "name": "vm_cluster",
              "plugin": {
                "kind": "MetricLabelValues",
                "spec": {
                  "labelName": "k8s_cluster_name",
                  "matchers": [
                    "kubevirt_vmi_info"
                  ]
                }
              },
              "sort": "alphabetical-asc"
            }
          },
          "persestextvariable": null
        },
        {
          "perseslistvariable": {
            "kind": "ListVariable",
            "spec": {
              "allowAllValue": true,
              "allowMultiple": true,
              "customAllValue": ".*",
              "defaultValue": {
                "perseslistvariabledefaultsinglevalue": {
                  "kind": "singleValue",
                  "singleValue": "{\"type\":\"Everything\"}"
                },
                "perseslistvariabledefaultslicevalues": null
              },
              "display": {
                "description": "Select one or more values. After changing a parent filter, reset the following filters to Everything.",
                "name": "Namespace"
              },
              "name": "vm_namespace",
              "plugin": {
                "kind": "MetricLabelValues",
                "spec": {
                  "labelName": "namespace",
                  "matchers": [
                    "kubevirt_vmi_info{k8s_cluster_name=~\"${vm_cluster}\"}"
                  ]
                }
              },
              "sort": "alphabetical-asc"
            }
          },
          "persestextvariable": null
        },
        {
          "perseslistvariable": {
            "kind": "ListVariable",
