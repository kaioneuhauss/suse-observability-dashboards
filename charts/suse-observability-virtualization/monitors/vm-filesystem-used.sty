nodes:
- _type: Monitor
  name: SRE · VM filesystem above 90 percent used · 15m
  identifier: urn:custom:monitor:sre-dashboards:vm-filesystem-used
  description: A filesystem reported by the VM guest agent remains above 90% used
    throughout observed samples over 15 minutes. Excludes temporary, boot, runtime
    and loop filesystems. Missing guest data does not imply free space. Health attaches
    to the host; the title identifies the VM and disk. Bind mounts of the same guest
    device are counted once.
  arguments:
    metric:
      query: min_over_time(((max by(k8s_cluster_name,namespace,name,disk_name,file_system_type)
        (kubevirt_vmi_filesystem_used_bytes{disk_name!~"(/dev/)?loop[0-9]+",file_system_type!~"tmpfs|overlay|squashfs",mount_point!~"/boot(/.*)?|/run(/.*)?"})
        / (max by(k8s_cluster_name,namespace,name,disk_name,file_system_type) (kubevirt_vmi_filesystem_capacity_bytes{disk_name!~"(/dev/)?loop[0-9]+",file_system_type!~"tmpfs|overlay|squashfs",mount_point!~"/boot(/.*)?|/run(/.*)?"})
        > 0)) * on(k8s_cluster_name,namespace,name) group_left(cluster_name,node)
        (label_replace(max by(k8s_cluster_name,namespace,name,node) (kubevirt_vmi_info{phase="running"}),
        "cluster_name", "$1", "k8s_cluster_name", "(.*)")))[15m:30s])
      unit: none
      aliasTemplate: ${cluster_name} · ${namespace} · ${name} · ${disk_name}
    comparator: GT
    threshold: 0.9
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · VM filesystem above 90 percent used · ${cluster_name} · ${namespace}
      · ${name} · ${disk_name}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Check free space inside the named VM filesystem, growth, logs and
    retention. Compare guest filesystem capacity with its virtual disk and Longhorn
    volume. Expand only through the supported storage and guest-filesystem process.
    Do not delete files automatically.
  tags:
  - sre-dashboards
  - dashboard-harvester
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
