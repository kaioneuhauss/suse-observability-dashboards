    "virtualization": {
      "type": "object",
      "required": [
        "otlp",
        "resources"
      ],
      "properties": {
        "otlp": {
          "type": "object",
          "required": [],
          "properties": {}
        },
        "scrapeInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "kubevirt": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "service": {
              "type": "string",
              "minLength": 1
            },
            "ca": {
              "type": "object",
              "properties": {
                "existingConfigMap": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "minLength": 1
                },
                "autoSync": {
                  "type": "boolean"
                },
                "sourceConfigMap": {
                  "type": "string",
                  "minLength": 1
                },
                "syncImage": {
