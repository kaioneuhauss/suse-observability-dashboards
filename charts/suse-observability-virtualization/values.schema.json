                        },
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$",
                          "not": {
                            "pattern": "^0+(?:\\.0+)?(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$"
                          }
                        }
                      ]
                    },
                    "memory": {
                      "anyOf": [
                        {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        {
                          "type": "string",
                          "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$",
                          "not": {
                            "pattern": "^0+(?:\\.0+)?(?:[eE][+-]?[0-9]+|[numkKMGTEP]i?)?$"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "podInventory": {
          "type": "object",
          "required": [
            "resources"
          ],
          "properties": {
            "resources": {
              "type": "object",
              "required": [
                "requests",
                "limits"
              ],
              "properties": {
                "requests": {
                  "type": "object",
                  "required": [
                    "cpu",
                    "memory"
                  ],
                  "properties": {
                    "cpu": {
                      "anyOf": [
                        {
                          "type": "number",
