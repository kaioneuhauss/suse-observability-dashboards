                  "minLength": 1
                }
              }
            },
            "serverNames": {
              "type": "object",
              "required": [
                "virt-api",
                "virt-handler",
                "virt-controller",
                "virt-operator"
              ],
              "minProperties": 4,
              "maxProperties": 4,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "safety": {
          "type": "object",
          "properties": {
            "profile": {
              "enum": [
                "conservative",
