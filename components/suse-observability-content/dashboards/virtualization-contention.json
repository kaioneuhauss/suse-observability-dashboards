{
  "name": "Virtualization · VM Contention",
  "description": "CPU scheduling, guest memory pressure and VM disk response.",
  "scope": "publicDashboard",
  "dashboard": {
    "metadata": {
      "project": "{\"saveVariables\":false}"
    },
    "spec": {
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 24,
                "height": 1,
                "content": {
                  "$ref": "#/spec/panels/guide"
                }
              },
              {
                "x": 0,
                "y": 1,
                "width": 8,
                "height": 2,
                "content": {
                  "$ref": "#/spec/panels/cpuReady"
                }
              },
              {
                "x": 8,
                "y": 1,
                "width": 8,
                "height": 2,
                "content": {
                  "$ref": "#/spec/panels/cpuUsage"
                }
              },
              {
                "x": 16,
                "y": 1,
                "width": 8,
                "height": 2,
                "content": {
                  "$ref": "#/spec/panels/memoryUse"
                }
              },
              {
                "x": 0,
                "y": 3,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/ready"
                }
              },
              {
                "x": 12,
                "y": 3,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/cpu"
                }
              },
              {
                "x": 0,
                "y": 6,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/ioWait"
                }
              },
              {
                "x": 12,
                "y": 6,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/memory"
                }
              },
              {
                "x": 0,
                "y": 9,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/faults"
                }
              },
              {
                "x": 12,
                "y": 9,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/swap"
                }
              },
              {
                "x": 0,
                "y": 12,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/readLatency"
                }
              },
              {
                "x": 12,
                "y": 12,
                "width": 12,
                "height": 3,
                "content": {
                  "$ref": "#/spec/panels/writeLatency"
                }
              }
            ]
          }
        }
      ],
      "panels": {
        "guide": {
          "spec": {
            "display": {
              "name": "Read this dashboard",
              "description": "The OS inside a VM, the VM resource configuration, and consumption on the Harvester server."
            },
            "plugin": {
              "kind": "Markdown",
              "spec": {
                "text": "**Follow the bottleneck.** Compare CPU usage with scheduler wait, guest memory with swap/page faults, and VM disk latency with Longhorn latency. Windows are 5 minutes. Empty is not zero. VM statistics require a running VMI; guest memory statistics depend on the guest balloon driver and platform support. These panels do not change VM resources."
              }
            },
            "queries": []
          }
        },
        "cpuReady": {
          "spec": {
            "display": {
              "name": "Worst CPU scheduler wait · %",
              "description": "Mean run-queue delay across vCPUs, then worst selected VM. A scheduling-pressure analogue to CPU Ready; not VMware-identical accounting. No factor of 1000: KubeVirt exports seconds.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 2,
                  "unit": "percent"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max(100 * avg by (k8s_cluster_name,namespace,name) (max by (k8s_cluster_name,namespace,name,id) (rate(kubevirt_vmi_vcpu_delay_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))))",
                      "alias": "Worst VM"
                    }
                  }
                }
              }
            ]
          }
        },
        "cpuUsage": {
          "spec": {
            "display": {
              "name": "Highest VM CPU use · %",
              "description": "Domain CPU seconds per second divided by configured cores × sockets × threads. Includes hypervisor/domain CPU accounting; inspect the time series before resizing.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 2,
                  "unit": "percent"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max(100 * (max by (k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_cpu_usage_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))) / ((max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"cores\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"sockets\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"threads\"})) > 0))",
                      "alias": "Highest VM"
                    }
                  }
                }
              }
            ]
          }
        },
        "memoryUse": {
          "spec": {
            "display": {
              "name": "Highest guest memory use · %",
              "description": "100 × (available - usable) / available. Usable corresponds to guest MemAvailable; reclaimable cache is not counted as used. Missing statistics remain empty.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "StatChart",
              "spec": {
                "calculation": "last",
                "format": {
                  "decimalPlaces": 2,
                  "unit": "percent"
                },
                "sparkline": false,
                "thresholds": {
                  "defaultColor": "#1976B9",
                  "steps": []
                },
                "valueFontSize": 40
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max(100 * (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) - max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_usable_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"})) / (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) > 0))",
                      "alias": "Highest VM"
                    }
                  }
                }
              }
            ]
          }
        },
        "ready": {
          "spec": {
            "display": {
              "name": "CPU scheduler wait by VM · %",
              "description": "Average per-vCPU scheduling delay over 5 minutes, deduplicated by VM and vCPU ID.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "100 * avg by (k8s_cluster_name,namespace,name) (max by (k8s_cluster_name,namespace,name,id) (rate(kubevirt_vmi_vcpu_delay_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])))",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}"
                    }
                  }
                }
              }
            ]
          }
        },
        "cpu": {
          "spec": {
            "display": {
              "name": "CPU use by VM · %",
              "description": "CPU demand relative to configured VM topology, not Kubernetes CPU request.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "100 * (max by (k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_cpu_usage_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))) / ((max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"cores\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"sockets\"}) * max by (k8s_cluster_name,namespace,name) (kubevirt_vm_resource_requests{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\",resource=\"cpu\",source=\"domain\",unit=\"threads\"})) > 0)",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}"
                    }
                  }
                }
              }
            ]
          }
        },
        "ioWait": {
          "spec": {
            "display": {
              "name": "vCPU I/O wait by VM · %",
              "description": "Time blocked on I/O, distinct from runnable CPU scheduler delay.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "100 * avg by (k8s_cluster_name,namespace,name) (max by (k8s_cluster_name,namespace,name,id) (rate(kubevirt_vmi_vcpu_wait_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])))",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}"
                    }
                  }
                }
              }
            ]
          }
        },
        "memory": {
          "spec": {
            "display": {
              "name": "Guest memory use by VM · %",
              "description": "Guest MemAvailable-based use; different from QEMU RSS and host RAM.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "percent"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "100 * (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) - max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_usable_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"})) / (max by (k8s_cluster_name,namespace,name) (kubevirt_vmi_memory_available_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}) > 0)",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}"
                    }
                  }
                }
              }
            ]
          }
        },
        "faults": {
          "spec": {
            "display": {
              "name": "Guest major page faults/s",
              "description": "Rate of major page faults; investigate together with swap activity and guest memory headroom.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "decimal"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max by (k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_memory_pgmajfault_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]))",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name}"
                    }
                  }
                }
              }
            ]
          }
        },
        "swap": {
          "spec": {
            "display": {
              "name": "Guest swap activity · estimated bytes/s",
              "description": "KubeVirt exposes cumulative swap traffic as gauges. Positive 5-minute delta / 300 estimates traffic; a guest reset may invalidate this window. Not a counter rate.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "bytes/sec"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max by (k8s_cluster_name,namespace,name) (clamp_min(delta(kubevirt_vmi_memory_swap_in_traffic_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]),0) / 300)",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · in"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max by (k8s_cluster_name,namespace,name) (clamp_min(delta(kubevirt_vmi_memory_swap_out_traffic_bytes{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m]),0) / 300)",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · out"
                    }
                  }
                }
              }
            ]
          }
        },
        "readLatency": {
          "spec": {
            "display": {
              "name": "VM disk read latency · ms",
              "description": "Mean seconds spent on I/O divided by completed I/Os, converted to milliseconds. One series per VM disk. Idle disks have no mean latency and remain empty.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "milliseconds"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "1000 * max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_read_times_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) / (max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_iops_read_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) > 0)",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · ${drive}"
                    }
                  }
                }
              }
            ]
          }
        },
        "writeLatency": {
          "spec": {
            "display": {
              "name": "VM disk write latency · ms",
              "description": "Mean seconds spent on I/O divided by completed I/Os, converted to milliseconds. One series per VM disk. Idle disks have no mean latency and remain empty.\n\nWhen to investigate / alert coverage: Context for investigation; not a paging rule. Verify source health and sample coverage before acting."
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "mode": "table",
                  "position": "bottom",
                  "show": true,
                  "values": []
                },
                "thresholds": {
                  "mode": "absolute",
                  "steps": []
                },
                "visual": {
                  "connectNulls": false
                },
                "yAxis": {
                  "format": {
                    "decimalPlaces": 2,
                    "unit": "milliseconds"
                  },
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "1000 * max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_write_times_seconds_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) / (max by (k8s_cluster_name,namespace,name,drive) (rate(kubevirt_vmi_storage_iops_write_total{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\",name=~\"${vm_name}\"}[5m])) > 0)",
                      "alias": "${k8s_cluster_name} · ${namespace} · ${name} · ${drive}"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "variables": [
        {
          "perseslistvariable": {
            "kind": "ListVariable",
            "spec": {
              "name": "vm_cluster",
              "display": {
                "name": "Cluster",
                "description": "Select one or more values. After changing a parent filter, reset the following filters to Everything."
              },
              "allowAllValue": true,
              "allowMultiple": true,
              "customAllValue": ".*",
              "sort": "alphabetical-asc",
              "defaultValue": {
                "perseslistvariabledefaultsinglevalue": {
                  "kind": "singleValue",
                  "singleValue": "{\"type\":\"Everything\"}"
                },
                "perseslistvariabledefaultslicevalues": null
              },
              "plugin": {
                "kind": "MetricLabelValues",
                "spec": {
                  "labelName": "k8s_cluster_name",
                  "matchers": [
                    "kubevirt_vmi_info"
                  ]
                }
              }
            }
          },
          "persestextvariable": null
        },
        {
          "perseslistvariable": {
            "kind": "ListVariable",
            "spec": {
              "name": "vm_namespace",
              "display": {
                "name": "Namespace",
                "description": "Select one or more values. After changing a parent filter, reset the following filters to Everything."
              },
              "allowAllValue": true,
              "allowMultiple": true,
              "customAllValue": ".*",
              "sort": "alphabetical-asc",
              "defaultValue": {
                "perseslistvariabledefaultsinglevalue": {
                  "kind": "singleValue",
                  "singleValue": "{\"type\":\"Everything\"}"
                },
                "perseslistvariabledefaultslicevalues": null
              },
              "plugin": {
                "kind": "MetricLabelValues",
                "spec": {
                  "labelName": "namespace",
                  "matchers": [
                    "kubevirt_vmi_info{k8s_cluster_name=~\"${vm_cluster}\"}"
                  ]
                }
              }
            }
          },
          "persestextvariable": null
        },
        {
          "perseslistvariable": {
            "kind": "ListVariable",
            "spec": {
              "name": "vm_name",
              "display": {
                "name": "VM",
                "description": "Select one or more values. After changing a parent filter, reset the following filters to Everything."
              },
              "allowAllValue": true,
              "allowMultiple": true,
              "customAllValue": ".*",
              "sort": "alphabetical-asc",
              "defaultValue": {
                "perseslistvariabledefaultsinglevalue": {
                  "kind": "singleValue",
                  "singleValue": "{\"type\":\"Everything\"}"
                },
                "perseslistvariabledefaultslicevalues": null
              },
              "plugin": {
                "kind": "MetricLabelValues",
                "spec": {
                  "labelName": "name",
                  "matchers": [
                    "kubevirt_vmi_info{k8s_cluster_name=~\"${vm_cluster}\",namespace=~\"${vm_namespace}\"}"
                  ]
                }
              }
            }
          },
          "persestextvariable": null
        }
      ]
    }
  }
}
