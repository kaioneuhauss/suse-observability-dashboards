nodes:
- _type: Monitor
  name: SRE · VM guest OS below 10 percent available RAM · 15m
  identifier: urn:custom:monitor:sre-dashboards:vm-guest-memory
  description: Checks VM guest OS below 10 percent available RAM · 15m. Values are
    evaluated every 60 seconds. Windows apply to observed samples; inspect collection
    health before interpreting a missing result. Thresholds are starting points to
    review against the workload baseline.
  arguments:
    metric:
      query: label_replace(max_over_time((max by (k8s_cluster_name,namespace,name,node)
        (kubevirt_vmi_memory_usable_bytes) / max by (k8s_cluster_name,namespace,name,node)
        (kubevirt_vmi_memory_available_bytes))[15m:30s]), "cluster_name", "$1", "k8s_cluster_name",
        "(.*)")
      unit: none
      aliasTemplate: ${cluster_name} · ${node} · ${name}
    comparator: LT
    threshold: 0.1
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · VM guest OS below 10 percent available RAM · 15m · ${cluster_name}
      · ${node} · ${name}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Locate the cluster and resource named in the alert. Compare
    the reported metric with the guest OS or Kubernetes API.

    2. Review the same time window for workload changes, limits, restarts and storage
    or memory pressure.

    3. Apply a workload-specific correction and verify recovery; do not delete data
    or raise limits automatically.'
  tags:
  - sre-dashboards
  - dashboard-harvester
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
