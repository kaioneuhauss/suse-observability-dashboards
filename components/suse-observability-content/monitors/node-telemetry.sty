nodes:
- _type: Monitor
  name: SRE · missing node OS telemetry · 5m
  identifier: urn:custom:monitor:sre-dashboards:node-telemetry
  description: Checks missing node OS telemetry · 5m. Values are evaluated every 60
    seconds. Windows apply to observed samples; inspect collection health before interpreting
    a missing result. Thresholds are starting points to review against the workload
    baseline.
  arguments:
    metric:
      query: min_over_time((((max by (cluster_name,node) (kubernetes_state_node_age)
        * 0 + 1) unless on (cluster_name,node) (max by (cluster_name,node) (up{job="sre-node"}
        == 1))) or on (cluster_name,node) (max by (cluster_name,node) (kubernetes_state_node_age)
        * 0))[5m:30s])
      unit: none
      aliasTemplate: ${cluster_name} · ${node}
    comparator: GT
    threshold: 0
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · missing node OS telemetry · 5m · ${cluster_name} · ${node}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: '1. Check the collector pod, readiness, recent and previous logs.

    2. Verify DNS, TLS, NetworkPolicy, endpoint reachability, ingestion credentials
    and remote-write responses.

    3. Check queue growth and dropped samples. A running pod does not prove successful
    delivery.'
  tags:
  - sre-dashboards
  - dashboard-platform
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
