nodes:
- _type: Monitor
  name: SRE · VM CPU scheduler wait above 10 percent · 10m
  identifier: urn:custom:monitor:sre-dashboards:vm-cpu-delay
  description: Each virtual CPU spends more than 10% of wall time, on average, waiting
    to run on a host CPU throughout observed samples in 10 minutes. KubeVirt scheduler
    delay is not automatically the VMware CPU Ready counter. Health is attached to
    the Harvester host; the title identifies the VM.
  arguments:
    metric:
      query: min_over_time((avg by(k8s_cluster_name,namespace,name) (rate(kubevirt_vmi_vcpu_delay_seconds_total[5m]))
        * on(k8s_cluster_name,namespace,name) group_left(cluster_name,node) (label_replace(max
        by(k8s_cluster_name,namespace,name,node) (kubevirt_vmi_info{phase="running"}),
        "cluster_name", "$1", "k8s_cluster_name", "(.*)")))[10m:30s])
      unit: none
      aliasTemplate: ${cluster_name} · ${namespace} · ${name}
    comparator: GT
    threshold: 0.1
    failureState: DEVIATING
    urnTemplate: urn:kubernetes:/${cluster_name}:node/${node}
    titleTemplate: SRE · VM CPU scheduler wait above 10 percent · 10m · ${cluster_name}
      · ${namespace} · ${name}
  intervalSeconds: 60
  status: ENABLED
  remediationHint: Check the named VM and its Harvester host. Compare host CPU busy,
    VM CPU consumption, allocation and competing VMs. Review scheduling and overcommit.
    Adjust the baseline to the workload before paging.
  tags:
  - sre-dashboards
  - dashboard-harvester
  function: {{ get "urn:stackpack:common:monitor-function:threshold" }}
